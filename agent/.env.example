# ── Wallets ───────────────────────────────────────────────────────────────────
AGENT_PRIVATE_KEY=0x...
OWNER_PRIVATE_KEY=0x...           # the agent owner, for messaging/sendCommand.ts
RENTER_PRIVATE_KEY=0x...          # only for renterListener.ts

# House bot — joins duels nobody has taken, so a challenge always gets an
# opponent. Runs rules, not a model: no API key needed. Give it its own funded
# address; it cannot join a duel it created itself.
HOUSE_BOT_PRIVATE_KEY=0x...
HOUSE_BOT_GRACE_MS=20000          # wait this long first, so humans get priority
HOUSE_BOT_MAX_STAKE=0.5           # refuses anything larger

# AES keys, required to encrypt final scores for settlement and to read private
# messages. Derived deterministically from the private keys above:
#   ts-node messaging/setup.ts
AES_KEY=
OWNER_AES_KEY=
RENTER_AES_KEY=
OWNER_ADDRESS=0x...               # rentalListener only accepts commands from this address
AGENT_ADDRESS=0x...               # messaging/sendCommand.ts sends to this address

# ── Contracts (printed by contracts/scripts/deploy-all.ts) ───────────────────
DUEL_MANAGER_ADDRESS=0x...
AGENT_REGISTRY_ADDRESS=0x...
AGENT_MARKETPLACE_ADDRESS=0x...
COTI_RPC=https://testnet.coti.io/rpc

# ── Strategy ──────────────────────────────────────────────────────────────────
STRATEGY=momentum                 # momentum | meanReversion | marketMaker
STAKE_ETH=0.1
DUEL_DURATION=86400
UPDATE_INTERVAL_MS=30000

# ── Agent server (src/server.ts) ──────────────────────────────────────────────
# ─── LLM (optional) ────────────────────────────────────────────────────────
# Only the strategy chat and the AI tick use this. Without it the agents still
# trade on their configured strategy and settlement is unaffected — the feed just
# says "holding — no LLM configured".
#
# Usage is small: about eight ~120-token calls per duel. Every free tier below
# covers that many times over, so configure two and a spent daily cap becomes a
# line in the log instead of an outage. The primary is tried first; the fallback
# only when the primary is unavailable (429, 402, 5xx, unreachable). A malformed
# request is not retried — it would fail identically at the second provider.
#
#   Groq        https://console.groq.com/keys        free, no card — good primary
#               AI_BASE_URL=https://api.groq.com/openai/v1
#               AI_MODEL=qwen/qwen3.8-27b
#   Ollama      https://ollama.com  — good fallback: free with no account, no
#               quota to exhaust and no credit to expire, and nothing leaves the
#               machine, which is the strongest privacy story available here.
#               ollama pull hermes3:8b
#               AI_FALLBACK_BASE_URL=http://localhost:11434/v1
#               AI_FALLBACK_API_KEY=ollama        (any non-empty string)
#               AI_FALLBACK_MODEL=hermes3:8b
#               Only reachable while it is running, so it covers local work and
#               demos rather than a deployed server.
#   xAI         https://console.x.ai   $25 on signup — but it does not always
#               arrive: a fresh account here got "your newly created team doesn't
#               have any credits or licenses yet". Check before relying on it.
#               AI_BASE_URL=https://api.x.ai/v1   AI_MODEL=grok-4.6
#
# Model names go stale. Ask the provider what your key can actually reach rather
# than trusting a guide — Groq dropped llama-3.3-70b-versatile, and the only
# symptom was a 404 saying the model "does not exist or you do not have access":
#
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $KEY"
#
# On Groq, qwen/qwen3.8-27b is the one that actually follows a trading strategy.
# The gpt-oss models answer just as fast but returned HOLD with no reasoning on
# every prompt tried, which is a working API call and a useless agent.
#   Cerebras    https://cloud.cerebras.ai            https://api.cerebras.ai/v1
#   OpenRouter  https://openrouter.ai/keys           https://openrouter.ai/api/v1
#   Ollama      local, nothing leaves the machine    http://localhost:11434/v1
#
# On data: a local model sends nothing anywhere. Groq does not train on prompts.
# xAI does not unless you opt into its data-sharing credits — which require
# spending $5 first and cannot be opted out of afterwards. Mistral's and Google's
# free tiers do train on them. The prompts here are prices and portfolio state
# rather than user secrets, but on a project selling confidentiality it is worth
# choosing rather than inheriting.

AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b

AI_FALLBACK_BASE_URL=http://localhost:11434/v1
AI_FALLBACK_API_KEY=ollama
AI_FALLBACK_MODEL=hermes3:8b

# Last resort, tried after both of the above.
MISTRAL_API_KEY=
PORT=3001
