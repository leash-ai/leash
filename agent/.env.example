# ── Wallets ───────────────────────────────────────────────────────────────────
AGENT_PRIVATE_KEY=0x...
OWNER_PRIVATE_KEY=0x...           # the agent owner, for messaging/sendCommand.ts
RENTER_PRIVATE_KEY=0x...          # only for renterListener.ts

# AES keys, required to encrypt final scores for settlement and to read private
# messages. Derived deterministically from the private keys above:
#   ts-node messaging/setup.ts
AES_KEY=
OWNER_AES_KEY=
RENTER_AES_KEY=
OWNER_ADDRESS=0x...               # rentalListener only accepts commands from this address
AGENT_ADDRESS=0x...               # messaging/sendCommand.ts sends to this address

# ── Contracts (printed by contracts/scripts/deploy-all.ts) ───────────────────
DUEL_MANAGER_ADDRESS=0x...
AGENT_REGISTRY_ADDRESS=0x...
AGENT_MARKETPLACE_ADDRESS=0x...
COTI_RPC=https://testnet.coti.io/rpc

# ── Strategy ──────────────────────────────────────────────────────────────────
STRATEGY=momentum                 # momentum | meanReversion | marketMaker
STAKE_ETH=0.1
DUEL_DURATION=86400
UPDATE_INTERVAL_MS=30000

# ── Agent server (src/server.ts) ──────────────────────────────────────────────
# ─── LLM (optional) ────────────────────────────────────────────────────────
# Only the strategy chat and the AI tick use this. Without it the agents still
# trade on their configured strategy and settlement is unaffected — the feed just
# says "holding — no LLM configured".
#
# Either point AI_BASE_URL at anything speaking OpenAI chat-completions, or set
# MISTRAL_API_KEY. AI_BASE_URL wins if both are present. Usage is tiny: roughly
# eight ~120-token calls per duel, so every free tier below covers it.
#
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1
#               AI_MODEL=llama-3.3-70b-versatile
#               free, no card, and does not train on your data
#   Cerebras    AI_BASE_URL=https://api.cerebras.ai/v1
#               AI_MODEL=llama-3.3-70b
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1
#               AI_MODEL=<any model ending in :free>
#   Ollama      AI_BASE_URL=http://localhost:11434/v1   AI_API_KEY=ollama
#               nothing leaves the machine
#
# Note for a privacy project: Mistral's and Google's free tiers train on your
# prompts. Groq's does not. The prompts here are prices and portfolio state, not
# user secrets, but it is worth choosing deliberately.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

MISTRAL_API_KEY=
PORT=3001
