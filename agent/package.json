{
  "name": "leash-agent",
  "version": "1.0.0",
  "description": "Leash AI agent \u2014 competes in private trading duels on COTI",
  "scripts": {
    "start": "ts-node src/server.ts",
    "dev": "ts-node-dev --respawn src/server.ts",
    "duel:create": "ts-node agent.ts create",
    "duel:join": "ts-node agent.ts join",
    "duel:run": "ts-node agent.ts run",
    "test": "node --test --require ts-node/register tests/*.test.ts",
    "check:types": "tsc --noEmit",
    "check:modules": "ts-node scripts/check-modules.ts",
    "check:llm": "ts-node scripts/check-llm.ts"
  },
  "dependencies": {
    "@coti-io/coti-ethers": "^1.0.5",
    "@coti-io/coti-sdk-private-messaging": "^0.2.3",
    "@mistralai/mistralai": "^2.3.0",
    "axios": "^1.7.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "express": "^5.2.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
