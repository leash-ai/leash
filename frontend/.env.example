NEXT_PUBLIC_DUEL_MANAGER_ADDRESS=0x...
NEXT_PUBLIC_COTI_RPC=https://testnet.coti.io/rpc

# Bot designer — server-side only, never exposed to the browser.
# Set these and /api/bot/design answers the build-a-bot conversation itself,
# so a deployment needs no separate agent server. Any OpenAI-compatible
# provider works (Groq, Cerebras, OpenRouter, xAI...). MISTRAL_API_KEY is
# used as a last resort. Leave unset if NEXT_PUBLIC_AGENT_URL points at an
# agent server that already holds the keys.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b

# The wallet the house bot plays from. Set it and the opponent side of a duel is
# named — the page recomputes the same draw the bot made from (duelId, startTime).
# Leave unset and it stays an address.
NEXT_PUBLIC_HOUSE_BOT_ADDRESS=
